# Copie para .env e preencha. Sem RESEND_API_KEY, os e-mails são apenas exibidos no log do MS Promoções.
RESEND_API_KEY=
# Sem domínio verificado na Resend, use onboarding@resend.dev (só entrega para o e-mail dono da conta).
RESEND_FROM=E-commerce SD <onboarding@resend.dev>
# Intervalo em segundos entre promoções geradas.
PROMOCAO_INTERVALO=30
